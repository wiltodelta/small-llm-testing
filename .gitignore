# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Ruff
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp

# Results (publish canonical outputs; ignore logs and intermediate snapshots)
results/*
!results/benchmark.json
!results/COMPARISON.md
!results/RESULTS.md

# Claude
_refs/
.claude/settings.local.json

# Claude Code isolated worktrees (per-agent sandbox clones)
.claude/worktrees/

# Other harnesses' generated config. Claude's sync owns these; a committed copy
# is a second source nobody reconciles. Anchored so a same-named source file
# deeper in the tree is not caught.
/.agents/
/.codex/
/.opencode/
/opencode.json
/opencode.jsonc
